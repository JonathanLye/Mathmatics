# 生产构建环境（build:prod / uni build --mode production）
# 背景：client.ts 的 DEFAULT_USE_MOCK 在 VITE_USE_MOCK 缺省时为 true（离线演示友好），
# 部署前必须显式关闭，否则产物走 mock 数据。此文件同时让默认 uni build（mode=production）安全。
VITE_USE_MOCK=false
# 生产构建不启用 mock 状态切换 / ?mock= 入口（practice: import.meta.env.VITE_ENABLE_MOCK === "1"）
VITE_ENABLE_MOCK=0
