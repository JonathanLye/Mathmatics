          { "label": "0", "insert": "0", "mode": "math" }
        ],
        [
          { "label": "+", "insert": "+", "mode": "math" }, { "label": "−", "insert": "-", "mode": "math" }, { "label": "×", "insert": "\\times ", "mode": "math" },
          { "label": "÷", "insert": "/", "mode": "math" }, { "label": ".", "insert": ".", "mode": "math" }, { "label": "x", "insert": "x", "mode": "math" },
          { "label": "y", "insert": "y", "mode": "math" }, { "label": "k", "insert": "k", "mode": "math" }, { "label": "m", "insert": "m", "mode": "math" },
          { "label": "A", "insert": "A", "mode": "math" }
        ]
      ]
    }
  ]
}
