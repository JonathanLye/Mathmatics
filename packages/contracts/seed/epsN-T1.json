        "hints": [
          {
            "level": "H0",
            "text": "你要让哪个量小于 $\\varepsilon$？先把它写成和 $|x-1|$ 有关的样子。",
            "cost": 0
          },
          {
            "level": "H1",
            "text": "回到目标：$|f(x)-3|<\\varepsilon$，而条件给的是 $|x-1|$ 很小。",
