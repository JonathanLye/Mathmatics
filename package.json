{
  "name": "proof-gym",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "node --watch apps/server/src/server.ts",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "node tools/smoke.mjs",
    "check:contracts": "node tools/check-contracts.mjs",
    "gen:types": "node tools/gen-types.mjs",
    "db:reset": "node apps/server/src/db/cli.ts reset",
    "db:migrate": "node apps/server/src/db/cli.ts migrate",
    "db:seed": "node apps/server/src/db/cli.ts seed",
    "db:query": "node apps/server/src/db/cli.ts query",
    "import:pdf": "node apps/import/src/cli.ts pdf",
    "import:items": "node apps/import/src/cli.ts items",
    "import:draft": "node apps/import/src/cli.ts draft",
    "import:publish": "node apps/import/src/cli.ts publish",
    "import:submit": "node apps/import/src/cli.ts submit",
    "import:run": "node apps/import/src/cli.ts run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
