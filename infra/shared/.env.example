# 复制为 infra/shared/.env 后填写；不要提交 .env（chmod 600）。
# 变量含义同 infra/.env.example；这里只列共用主机部署需要的。
POSTGRES_PASSWORD=change-me
NODE_ENV=production
LOG_LEVEL=info

# 镜像：默认用本机构建后 docker load 的本地名；改用 GHCR（推荐，见 README“后续更新”）时取消注释。
# TAG 每次更新时在命令行传入（TAG=sha-xxxxxxxx docker compose ...），不要写死在这里。
# SERVER_IMAGE=ghcr.io/jonathanlye/proofgym-server
# WEB_IMAGE=ghcr.io/jonathanlye/proofgym-web
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16

# 回环端口（仅 127.0.0.1）。与主机上已占用端口冲突时改这里：主站占了 3000/8787/8788/8789/8923/9090。
GYM_WEB_PORT=18080
GYM_SERVER_PORT=18081

# 会话与个人信息：用 openssl rand -base64 32 各生成一份，三个值互不相同。
SESSION_SECRET=
PII_KEY=
STUDENT_NO_PEPPER=

# 学生登录每 IP 每分钟上限；校园网共用出口 IP 时调大。
RATE_LIMIT_LOGIN_PER_MIN=120

# 模型与识别：留空则对应调用被跳过，/health 显示 degraded，不阻止启动。
JEV_BASE_URL=
JEV_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
SIMPLETEX_APP_ID=
SIMPLETEX_APP_SECRET=
