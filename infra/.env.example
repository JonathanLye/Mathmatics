# 复制为 infra/.env 后填写；不要提交 .env
PUBLIC_ORIGIN=localhost
POSTGRES_PASSWORD=change-me

NODE_ENV=production
LOG_LEVEL=info

# 容器内必须监听 0.0.0.0，Caddy 才能连到 server:3000（docker-compose.yml 已显式设置；本机开发不要设）
HOST=0.0.0.0

# 每会话每分钟限流（可选；默认 120/60）。学生登录按 IP 限流的上限在代码里固定为 120 次/分。
RATE_LIMIT_EVENTS_PER_MIN=120
RATE_LIMIT_HELP_PER_MIN=60
# 学生登录每 IP 每分钟上限；校园网多个班共用一个出口 IP 时调大（默认 120）
RATE_LIMIT_LOGIN_PER_MIN=120

# 学生密码强制：true=没设密码的学生先被引导去设密码，设好前其余学生接口 403（现有测试账号下次登录设密码）。生产保持 true。
STUDENT_PASSWORD_ENFORCE=true

# 会话与个人信息（05 §8.2）
# 生成示例（Linux/macOS）：
#   SESSION_SECRET=$(openssl rand -base64 32)
#   PII_KEY=$(openssl rand -base64 32)          # 必须是 base64 的 32 字节（AES-256）
#   STUDENT_NO_PEPPER=$(openssl rand -base64 32)
#   MIRROR_TOKEN_SECRET=$(openssl rand -base64 32)
SESSION_SECRET=至少32个字符的随机串
PII_KEY=base64-encoded-32-bytes
STUDENT_NO_PEPPER=随机串
# 镜像令牌当前用 SESSION_SECRET 签发（05 §7）；MIRROR_TOKEN_SECRET 预留未使用，设了也不生效。
MIRROR_TOKEN_SECRET=

# 模型与识别（P0 可留空：网关与识别走降级/预写内容）
JEV_BASE_URL=
JEV_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
SIMPLETEX_APP_ID=
SIMPLETEX_APP_SECRET=
# 可选：覆盖 apps/server/config/models.yaml 里的模型 ID（MODEL_<角色>），如交叉校验模型 ID 不存在时：
# MODEL_CROSS=qwen-flash

# 健康明细（GET /health/details，请求头 x-health-token）的令牌：openssl rand -hex 16。留空则明细接口一律 404。
# 公开的 /health 只回 {ok,status,service}；Caddy 不反代 /health/details，值守用 docker compose exec server 在容器内访问。
HEALTH_TOKEN=

# 手写/拍照识别的文件存储：compose 已把命名卷 server_data 挂到 /data/files（node 用户可写）；一般不用改。
STORAGE_DIR=/data/files

# 以下为 P1 预留：成本告警尚未接入，当前设了也不生效。
DAILY_COST_ALERT_CNY=50
DAILY_COST_CUTOFF_CNY=100
ALERT_WEBHOOK=
